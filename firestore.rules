rules_version = '2';

// Finkas — Firestore security rules.
//
// The web client never talks to Firestore directly. Every read and write goes
// through the serverless functions in /api (see api/data.js), which use the
// Google service account and therefore bypass these rules entirely.
//
// Denying all client access closes the previous model where:
//   • every collection was world-readable (member names, WhatsApp numbers,
//     contribution history and cash flows of every group),
//   • `groups/{gid}` could be rewritten by anyone, letting an attacker replace
//     admin_password_hash / pin_hash and take over the group,
//   • credential hashes were readable, so the 4-digit PIN could be cracked
//     offline in milliseconds,
//   • `settings/app_config` was client-readable while holding the master
//     password hash.
//
// If direct client access is ever required, scope it to `request.auth` and a
// group membership claim — never re-introduce `if true`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
