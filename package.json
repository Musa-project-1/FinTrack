{
  "name": "finkas",
  "version": "1.0.0",
  "private": true,
  "description": "Finkas - Modern PWA Kas & Iuran",
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "build:html": "node scripts/build-html.js",
    "build:css": "npx @tailwindcss/cli -i ./css/input.css -o ./style.css --minify",
    "build": "npm run build:html && npm run build:css",
    "dev:css": "npx @tailwindcss/cli -i ./css/input.css -o ./style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
