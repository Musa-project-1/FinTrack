{
  "name": "finkas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Finkas - Modern PWA Kas & Iuran",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "test": "node --localstorage-file=./.test-localstorage.json --test \"tests/**/*.test.mjs\"",
    "check": "npm run verify && npm test",
    "bump": "node scripts/bump.mjs",
    "build:html": "node scripts/build-html.cjs",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./css/input.css -o ./style.css --minify",
    "build": "npm run build:svelte && npm run build:html && npm run build:css",
    "dev:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./css/input.css -o ./style.css --watch",
    "build:svelte": "vite build && vite build --config vite.onboarding.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^26.1.0",
    "svelte": "^5.59.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
