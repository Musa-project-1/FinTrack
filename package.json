{
  "name": "finkas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Finkas - Modern PWA Kas & Iuran",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/render-shells.mjs && vite build && node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/input.css -o ./style.css --minify",
    "test:node": "node --localstorage-file=./.test-localstorage.json --test \"tests/**/*.test.mjs\"",
    "test:vitest": "vitest run",
    "test": "npm run test:node && npm run test:vitest",
    "typecheck": "tsc --noEmit && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check": "npm run build && node scripts/verify.mjs && npm run typecheck && npm test",
    "release": "node scripts/bump.mjs && npm run check"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^26.1.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
