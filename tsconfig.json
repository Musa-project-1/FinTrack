{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "finkas/hybrid-motion": ["./src/ui/hybrid-motion.js"],
      "finkas/dues-status": ["./src/ui/dues-status.js"],
      "finkas/pagination": ["./src/ui/pagination.js"],
      "finkas/bulk-dues": ["./src/svelte/types/bulk-dues.d.ts", "./src/ui/bulk-dues.js"],
      "finkas/receipt": ["./src/svelte/types/receipt.d.ts", "./src/render/receipt.js"],
      "finkas/self-pay": ["./src/svelte/types/self-pay.d.ts", "./src/handlers/self-pay.js"]
    },
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/**/*.js",
    "src/ui/svelte-dashboard.d.ts",
    "src/ui/svelte-onboarding.d.ts",
    "api/**/*.js",
    "src/svelte/**/*.ts",
    "src/svelte/**/*.svelte"
  ],
  "exclude": ["src/ui/svelte-dashboard.js", "src/ui/svelte-onboarding.js"]
}
