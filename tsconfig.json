{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "finkas/core/*": ["./src/svelte/core/*"],
      "finkas/hybrid-motion": ["./src/svelte/ui/hybrid-motion.ts"],
      "finkas/dues-status": ["./src/svelte/ui/dues-status.ts"],
      "finkas/pagination": ["./src/svelte/ui/pagination.ts"],
      "finkas/bulk-dues": ["./src/svelte/ui/bulk-dues.ts"],
      "finkas/receipt": ["./src/svelte/render/receipt.ts"],
      "finkas/self-pay": ["./src/svelte/handlers/self-pay.ts"]
    },
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/**/*.js",
    "src/ui/svelte-dashboard.d.ts",
    "src/ui/svelte-onboarding.d.ts",
    "api/**/*.js",
    "src/svelte/**/*.ts",
    "src/svelte/**/*.svelte"
  ],
  "exclude": ["src/ui/svelte-dashboard.js", "src/ui/svelte-onboarding.js"]
}
