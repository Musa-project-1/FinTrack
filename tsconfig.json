{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "finkas/hybrid-motion": ["./src/ui/hybrid-motion.js"] },
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/types/**/*.d.ts", "src/core/**/*.js", "api/**/*.js", "src/svelte/**/*.ts"]
}
